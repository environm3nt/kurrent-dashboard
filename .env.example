# ============================================
# Kurrent dashboard — environment variables
# Copy to .env.local. Never commit .env.local.
# ============================================

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server-side only. Used for auto-provisioning, admin pages, invitations.
SUPABASE_SERVICE_ROLE_KEY=

# --- Platform admins ---
# Comma-separated. Server routes read PLATFORM_ADMIN_EMAILS; the sidebar reads the
# NEXT_PUBLIC_ copy to decide whether to show the admin links. Set both the same.
PLATFORM_ADMIN_EMAILS=
NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS=

# --- On-demand features (optional) ---
# Candidate search + scoring from a lead
PDL_API_KEY=
CLAUDE_API_KEY=
# Lead PDF report and industry briefs
PDFMONKEY_API_KEY=
PDFMONKEY_TEMPLATE_ID=
INDUSTRY_BRIEF_TEMPLATE_ID=
# Company enrichment
APOLLO_API_KEY=
# Team invitations
RESEND_API_KEY=

# --- Pricing page (optional) ---
# "starter:499,growth:799,scale:1299" renders amounts; unset shows "Custom".
NEXT_PUBLIC_TIER_PRICES=

# --- Deployment ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
